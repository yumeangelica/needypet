{
  "name": "needypet-client",
  "private": true,
  "version": "2.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && rm -rf ../server/dist && vite build && cp -r dist ../server",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check ../client",
    "lint:fix": "biome check --write ../client"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@tailwindcss/vite": "^4.3.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  },
  "description": "NeedyPet Vue client"
}
